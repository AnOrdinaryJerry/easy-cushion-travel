{
	"schemaVersion": 1,
	"id": "easycushiontravel",
	"version": "${version}",
	"name": "Easy Cushion Travel",
	"description": "An easier way to travel with cushions!",
	"authors": [
		"Jerdigo (Jerry)"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/easycushiontravel/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.anordinaryjerry.easycushiontravel.EasyCushionTravel"
		],
		"client": [
			"io.github.anordinaryjerry.easycushiontravel.client.EasyCushionTravelClient"
		]
	},
	"mixins": [
		"easycushiontravel.mixins.json",
		{
			"config": "easycushiontravel.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}